{%- comment -%}
  Imagen o placeholder. Uso: {% render 'hk-img', image: block.settings.image, label: 'G1 · Producto', sizes: '(min-width: 990px) 50vw, 100vw', eager: false %}
{%- endcomment -%}
{%- if image != blank -%}
  {%- liquid
    assign loading = 'lazy'
    if eager
      assign loading = 'eager'
    endif
  -%}
  {{ image | image_url: width: 1600 | image_tag: class: 'hk-img', loading: loading, sizes: sizes, widths: '400, 800, 1200, 1600', alt: image.alt | default: label }}
{%- else -%}
  <div class="hk-ph" role="img" aria-label="{{ label | escape }}">{{ label }}</div>
{%- endif -%}
